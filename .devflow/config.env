DEVFLOW_APP=teams-transcription
DEVFLOW_SERVICE=teams-transcription
DEVFLOW_DEPLOY=true
DEVFLOW_DEPLOY_MANUAL_ONLY=true
DEVFLOW_PORT=18101
DEVFLOW_APP_PORT=8080
DEVFLOW_HEALTH_PATH=/healthz
DEVFLOW_MERGE_METHOD=merge
DEVFLOW_RELEASE_FILES=docker/chromium-seccomp.json
DEVFLOW_REVIEW_TEST_CMD=PYTHONPATH=tests:. python3 -m unittest test_workflow_triggers test_isolated_deployment test_target_deploy -v
# Manual deploy.yml only; merge never dispatches deployment.
