DEVFLOW_APP=teams-transcription
DEVFLOW_SERVICE=teams-transcription
DEVFLOW_DEPLOY=true
DEVFLOW_DEPLOY_MANUAL_ONLY=false
DEVFLOW_PORT=18101
DEVFLOW_APP_PORT=8080
DEVFLOW_HEALTH_PATH=/healthz
DEVFLOW_MERGE_METHOD=merge
DEVFLOW_RELEASE_FILES=docker/chromium-seccomp.json
DEVFLOW_LOCK_FILE="$HOME/.devflow-live/timmypai-teams-transcription/operation.lock"
DEVFLOW_REVIEW_TEST_CMD='PYTHONPATH=tests:. python3 -m unittest test_workflow_triggers test_isolated_deployment test_target_deploy test_standard_deploy_migration -v'
# Auto-deploy on main push (default-tip only) + manual workflow_dispatch; control/operate/staging workflows stay manual-only.
