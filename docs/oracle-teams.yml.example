# Review-only example. Not an active .github workflow or a hook permission grant.
name: Oracle single Teams acceptance
on:
  workflow_dispatch:
    inputs:
      operation:
        type: choice
        options: [offline, run]
        default: offline
      confirm_meeting:
        type: boolean
        default: false
permissions: {}
concurrency:
  group: oracle-staging
  cancel-in-progress: false
jobs:
  acceptance:
    if: github.repository == 'paulpai0412/teams-transcription' && github.ref == 'refs/heads/main' && vars.STAGING_READY == 'true'
    environment: staging
    runs-on: [self-hosted, Linux, ARM64, teams-transcription-staging]
    timeout-minutes: 5
    steps:
      - name: Fixed installed authenticated single-meeting helper
        env:
          TEAMS_OPERATION: ${{ inputs.operation }}
          STAGING_TEAMS_AUTHORIZED: ${{ inputs.confirm_meeting }}
        run: |
          set -euo pipefail
          /opt/teams-staging/bin/teams-acceptance "$TEAMS_OPERATION" | tee "$RUNNER_TEMP/teams-acceptance.json"
      - name: Only projected scalar result
        if: always()
        uses: actions/upload-artifact@ea165f8d65b6e75b540449e92b4886f43607fa02
        with:
          name: teams-acceptance-${{ github.run_id }}-${{ github.run_attempt }}
          path: ${{ runner.temp }}/teams-acceptance.json
          retention-days: 7
          if-no-files-found: warn
