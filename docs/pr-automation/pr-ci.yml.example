# INACTIVE DESIGN EXAMPLE. This file is outside .github/workflows.
# Moving it requires owner approval for recurring compute, prerequisites,
# complete applicable test profiles, provenance and the enforcement boundaries.
# It is not an activation-ready required-check contract.
name: PR offline tests (proposal)
on:
  pull_request:
    types: [opened, reopened, synchronize, ready_for_review]
permissions:
  contents: read
concurrency:
  group: pr-offline-${{ github.event.pull_request.number }}
  cancel-in-progress: true
jobs:
  pr-contracts:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-24.04
    timeout-minutes: 10
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - run: python -m pip install --disable-pip-version-check .
      - name: Policy regressions and existing controlled offline contracts
        env:
          CODEX_HOME: ${{ runner.temp }}/empty-codex-home
        run: python tools/ci_contracts.py "$RUNNER_TEMP/contracts"
  pr-full-regression:
    if: github.event.pull_request.draft == false
    runs-on: ubuntu-24.04
    timeout-minutes: 20
    steps:
      - uses: actions/checkout@34e114876b0b11c390a56381ad16ebd13914f8d5 # v4.3.1
        with:
          persist-credentials: false
      - uses: actions/setup-python@a26af69be951a213d495a4c3e4e4022e16d87065 # v5.6.0
        with:
          python-version: '3.12'
      - run: python -m pip install --disable-pip-version-check '.[bridge-test]'
      - name: Full discovery (missing prerequisites must fail)
        env:
          CODEX_HOME: ${{ runner.temp }}/empty-codex-home
        run: python -m unittest discover -s tests -v
# Native sandboxed Chromium, Node/FFmpeg, fixed Codex CLI and the two missing
# historical experiment modules still need an approved, reproducible test image
# or prerequisite plan. Do not delete suites, turn failures into skips, or treat
# this proposal/controlled subset as full media validation. No secrets, cache,
# Oracle/self-hosted runners, artifact consumption or privileged PR trigger.
