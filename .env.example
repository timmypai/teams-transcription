# Required operator values. This file contains no password, token or meeting URL.
TRANSCRIPTION_IMAGE=
CONTAINER_PLATFORM=
PUID=
PGID=
APPDATA_HOST=
CONFIG_ENV_FILE=.env
HOST_PORT=8080
CPU_LIMIT=2
MEM_LIMIT=4g
SHM_SIZE=1gb
PIDS_LIMIT=512
STOP_GRACE=45s
# A Codex directory from THIS authorized deployment only; never extract/copy
# another environment's OAuth material. compose.auth.yml is an explicit opt-in.
CODEX_AUTH_HOME_HOST=
ASSISTANT_HOST=0.0.0.0
ASSISTANT_PORT=8080
ASSISTANT_DATA_ROOT=/data
ASSISTANT_PUBLIC_BASE_URL=
ASSISTANT_COOKIE_SECURE=false
ASSISTANT_TIMEZONE=Asia/Taipei
ASSISTANT_CALENDAR_POLL_SECONDS=60
# Optional operator cap; null leaves the authorized occurrence end as the limit.
ASSISTANT_MAX_DURATION_SECONDS=null
ASSISTANT_SHUTDOWN_SECONDS=30
ASSISTANT_SUMMARY_MODEL=
ASSISTANT_ALLOWED_EGRESS_HOSTS=[]
